# Cloudflare Pages 响应头
# 开启跨源隔离（crossOriginIsolated），解锁 SharedArrayBuffer，
# 让 ONNX Runtime WASM 多线程推理（手机端提速数倍）。
# 兼容性：不支持 COEP 的旧浏览器会忽略该头，自动回退单线程，不影响功能。
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# 代码与样式：文件名没有内容哈希，默认 max-age=14400 会让浏览器
# 在发版后最多 4 小时仍用旧 JS（新 HTML + 旧 JS = 交互失灵）。
# 改为每次都回源校验（命中 ETag 走 304，几乎不额外消耗流量）。
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache
